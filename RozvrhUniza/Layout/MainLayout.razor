@inherits LayoutComponentBase

@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<div class="page d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="/">UNIZA Rozvrh Viewer</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <NavLink class="nav-link" Match="NavLinkMatch.All" href="./">Predmet</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="./teachers">Učitelia</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="./rooms">Miestnosti</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="./teacher-export">Export rozvrhu</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="./intersections">Vyhľadávanie prienikov</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="./cache-management">⚙️ Cache</NavLink>
                    </li>
                </ul>
                <div class="ms-lg-3 mt-2 mt-lg-0">
                    <button class="btn btn-outline-light btn-sm" @onclick="ToggleTheme">@_themeButtonText</button>
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            @Body
        </div>
    </main>

    <footer class="bg-light border-top py-3">
        <div class="container text-center text-muted small">
            © @DateTime.Now.Year Michal Ďuračík, <a target="_blank" href="https://www.fri.uniza.sk/">FRI</a>, UNIZA
        </div>
    </footer>
</div>

@code {
    private string _themeButtonText = "🌙 Tmavý";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var t = await JS.InvokeAsync<string>("theme.get");
                UpdateButtonText(t);
                StateHasChanged();
            }
            catch
            {
                // no-op if theme script not loaded yet
            }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            await JS.InvokeVoidAsync("theme.toggle");
            var t = await JS.InvokeAsync<string>("theme.get");
            UpdateButtonText(t);
        }
        catch { }
    }

    private void UpdateButtonText(string? theme)
    {
        _themeButtonText = theme == "dark" ? "☀️ Svetlý" : "🌙 Tmavý";
    }
}
