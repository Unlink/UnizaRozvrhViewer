@page "/"
@using KST.UnizaSchedule.Table
@using KST.UnizaSchedule.Api
@using KST.UnizaSchedule.Api.Enums
@using KST.UnizaSchedule.Api.ScheduleRequests
@using RozvrhUniza.Components

@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Prehľadný rozvrh - Predmet</PageTitle>

<form onsubmit="return false;">
    <div class="mb-3">
        <label class="form-label">Kód predmetu</label>
        <input type="text" class="form-control" @bind="Subject" maxlength="10">
    </div>
    <div class="mb-3">
        <label class="form-label">Stupeň</label>
        <select class="form-select" @bind="StudyForm">
            <option value="@UnizaStudyForm.BachalorStudy">BC</option>
            <option value="@UnizaStudyForm.MasterStudy">Ing</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Ročník</label>
        <input type="number" min="1" max="3" step="1" class="form-control" @bind="SubjectYear">
    </div>
    <div class="mb-3">
        <label class="form-label">Semester</label>
        <select class="form-select" @bind="Semester">
            <option value="@KST.UnizaSchedule.Api.Enums.Semester.Winter">Zima</option>
            <option value="@KST.UnizaSchedule.Api.Enums.Semester.Summer">Leto</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary" @onclick="LoadRozvrh">Zobraziť rozvrh</button>
</form>

@if (_sheduleData != null)
{
    <ScheduleView Data="@this._sheduleData" />
}

@if (_hasError)
{
    <div class="alert alert-danger" role="alert">
        Rozvrh nenájdený!
    </div>
}

@code {
    private const string SubjectFormStorageKey = "rozvrh_predmet_form";
    private string _subject = "6BI0011";
    private UnizaStudyForm _studyForm = UnizaStudyForm.BachalorStudy;
    private int _subjectYear = 1;
    private int _year = DateTime.Now.Year;
    private Semester _semester = Semester.Winter;
    private bool _hasError = false;
    private GroupedScheduleTable? _sheduleData;

    public string Subject
    {
        get => _subject;
        set
        {
            if (_subject != value)
            {
                _subject = value;
                _ = SaveFormToLocalStorage();
            }
        }
    }
    public UnizaStudyForm StudyForm
    {
        get => _studyForm;
        set
        {
            if (_studyForm != value)
            {
                _studyForm = value;
                _ = SaveFormToLocalStorage();
            }
        }
    }
    public int SubjectYear
    {
        get => _subjectYear;
        set
        {
            if (_subjectYear != value)
            {
                _subjectYear = value;
                _ = SaveFormToLocalStorage();
            }
        }
    }
    public Semester Semester
    {
        get => _semester;
        set
        {
            if (_semester != value)
            {
                _semester = value;
                _ = SaveFormToLocalStorage();
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        bool loaded = await LoadFormFromLocalStorage();
        if (!loaded)
        {
            _semester = ScheduleApiHelpers.GetSemester(DateTime.Now);
            _year = ScheduleApiHelpers.GetStudyYear(DateTime.Now);
        }
        else
        {
            _year = ScheduleApiHelpers.GetStudyYear(DateTime.Now);
        }
    }

    private async Task LoadRozvrh()
    {
        this._sheduleData = null;
        _hasError = false;
        try
        {
            this._sheduleData = (await ScheduleApi.GetUnizaScheduleContentAsync(new SubjectScheduleRequest(
                UnizaFaculty.FRI,
                _studyForm,
                _subjectYear,
                _subject,
                _year,
                _semester)))
                .MergeMultipleTeachers()
                .ToTable()
                .GroupSameBlocks();
            _hasError = false;
        }
        catch (Exception ex)
        {
            _hasError = true;
            Logger.LogError(ex, "Nepodarilo sa načítať rozvrh");
        }
        StateHasChanged();
    }

    private async Task SaveFormToLocalStorage()
    {
        var formData = new SubjectFormData
        {
            Subject = _subject,
            StudyForm = _studyForm,
            SubjectYear = _subjectYear,
            Semester = _semester
        };
        var json = System.Text.Json.JsonSerializer.Serialize(formData);
        await JS.InvokeVoidAsync("localStorage.setItem", SubjectFormStorageKey, json);
    }

    private async Task<bool> LoadFormFromLocalStorage()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", SubjectFormStorageKey);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<SubjectFormData>(json);
                if (loaded != null)
                {
                    _subject = loaded.Subject ?? _subject;
                    _studyForm = loaded.StudyForm;
                    _subjectYear = loaded.SubjectYear;
                    _semester = loaded.Semester;
                    return true;
                }
            }
            catch { }
        }
        return false;
    }

    private class SubjectFormData
    {
        public string? Subject { get; set; }
        public UnizaStudyForm StudyForm { get; set; }
        public int SubjectYear { get; set; }
        public Semester Semester { get; set; }
    }
}