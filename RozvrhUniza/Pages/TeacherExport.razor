    private string GetSubjectBasedFill(string? courseOrShortcut, KST.UnizaSchedule.Api.Enums.LessonType type)
    {
        var baseHex = GetSubjectColorHex(courseOrShortcut);
        if (string.IsNullOrWhiteSpace(baseHex))
        {
            return GetFillHex(type);
        }
        // Lecture should be darker shade of subject color
        if (type == KST.UnizaSchedule.Api.Enums.LessonType.Lecture)
            return DarkenHex(baseHex, 0.25);
        // Exercises/Labs: base color
        return baseHex;
    }

    private string GetSubjectColorHex(string? courseOrShortcut)
    {
        if (string.IsNullOrWhiteSpace(courseOrShortcut)) return "";
        if (_subjectColors.TryGetValue(courseOrShortcut, out var c) && !string.IsNullOrWhiteSpace(c)) return NormalizeHex(c);
        // try find by alias reverse mapping
        var kv = _subjectAliases.FirstOrDefault(kv => string.Equals(kv.Value, courseOrShortcut, StringComparison.Ordinal));
        if (!string.IsNullOrEmpty(kv.Key) && _subjectColors.TryGetValue(kv.Key, out var c2)) return NormalizeHex(c2);
        return "";
    }

    private static string NormalizeHex(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#000000";
        var h = hex.Trim();
        if (!h.StartsWith('#')) h = "#" + h;
        if (h.Length == 4) // #RGB -> #RRGGBB
        {
            h = "#" + new string(new[] { h[1], h[1], h[2], h[2], h[3], h[3] });
        }
        return h.Length >= 7 ? h.Substring(0, 7) : h;
    }

    private static string DarkenHex(string hex, double amount)
    {
        (int r, int g, int b) = ParseHex(hex);
        r = (int)Math.Clamp(r * (1 - amount), 0, 255);
        g = (int)Math.Clamp(g * (1 - amount), 0, 255);
        b = (int)Math.Clamp(b * (1 - amount), 0, 255);
        return $"#{r:X2}{g:X2}{b:X2}";
    }

    private static (int r, int g, int b) ParseHex(string hex)
    {
        var h = NormalizeStaticHex(hex);
        int r = Convert.ToInt32(h.Substring(1, 2), 16);
        int g = Convert.ToInt32(h.Substring(3, 2), 16);
        int b = Convert.ToInt32(h.Substring(5, 2), 16);
        return (r, g, b);
    }

    private static string NormalizeStaticHex(string? hex)
    {
        if (string.IsNullOrWhiteSpace(hex)) return "#000000";
        var h = hex.Trim();
        if (!h.StartsWith('#')) h = "#" + h;
        if (h.Length == 4)
        {
            h = "#" + new string(new[] { h[1], h[1], h[2], h[2], h[3], h[3] });
        }
        if (h.Length < 7) h = h.PadRight(7, '0');
        return h.Substring(0, 7);
    }

    private static string GetIdealTextColor(string bgHex)
    {
        var (r, g, b) = ParseHex(bgHex);
        // Perceived brightness formula
        var brightness = (r * 299 + g * 587 + b * 114) / 1000;
        return brightness < 128 ? "#FFFFFF" : "#000000";
    }

