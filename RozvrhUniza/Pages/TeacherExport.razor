    private void ComputeEditWarning()
    {
        if (_scheduleOcc is null || _editStart is null) { _editWarning = null; return; }
        int h = _editStart.Value.Hour;
        int m = _editStart.Value.Minute;
        int start = (h - ScheduleTable.FirstBlockHour) * 2 + (m >= 30 ? 1 : 0);
        int dur = Math.Max(1, _editDurationHalfSlots);
        var occ = _scheduleOcc.TryGetValue(_editDay, out var arr) ? arr : null;
        if (occ is null) { _editWarning = null; return; }
        int total = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
        int s = Math.Clamp(start, 0, total);
        int e = Math.Clamp(start + dur, 0, total);
        bool overlap = false;
        for (int i = s; i < e; i++) if (occ[i]) { overlap = true; break; }
        _editWarning = overlap ? "Pozor: blok sa prekrýva s existujúcim rozvrhom." : null;
    }

    private void OnEditAfterChange()
    {
        ComputeEditWarning();
    }

