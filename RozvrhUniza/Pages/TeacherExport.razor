@page "/teacher-export"
@using KST.UnizaSchedule.Api
@using KST.UnizaSchedule.Api.ScheduleRequests
@using KST.UnizaSchedule.Table
@using ClosedXML.Excel
@using Microsoft.AspNetCore.Components.Web
@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Export rozvrhu - Učiteľ</PageTitle>

<h4>Export rozvrhu do Excelu</h4>

<div class="mb-3">
    <label class="form-label">Vyhľadať učiteľa</label>
    <input type="text" class="form-control" value="@_search" @oninput="OnSearchChanged" />
    @if (_suggestions.Any())
    {
        <ul class="dropdown-menu d-block">
            @foreach (var s in _suggestions)
            {
                <li @onclick="() => SelectTeacher(s)"><a class="dropdown-item">@s.Name</a></li>
            }
        </ul>
    }
</div>

<div class="form-check mb-3">
    <input class="form-check-input" type="checkbox" id="includeBlocks" @bind="IncludeBlocks" />
    <label class="form-check-label" for="includeBlocks">Zahrnúť bloky</label>
</div>

@if (_subjectEditor.Any())
{
    <h5>Názvy predmetov</h5>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:55%">Oficiálny názov</th>
                    <th style="width:25%">Moja skratka</th>
                    <th style="width:10%">Farba</th>
                    <th style="width:10%"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _subjectEditor)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>
                            <input type="text" class="form-control form-control-sm" @bind-value="item.Alias" @bind-value:event="oninput" />
                        </td>
                        <td>
                            <input type="color" class="form-control form-control-sm" style="height:2rem;padding:0;" @bind-value="item.Color" @bind-value:event="oninput" />
                        </td>
                        <td>
                            <button class="btn btn-outline-secondary btn-sm" title="Vymazať skratku" @onclick="() => { item.Alias = string.Empty; }">X</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <button class="btn btn-outline-primary btn-sm" @onclick="SaveSubjectAliasesToLocalStorage">Uložiť názvy a farby</button>
}

@if (_selectedTeacher is not null)
{
    <div class="alert alert-info mt-3">Vybraný učiteľ: <strong>@_selectedTeacher.Name</strong></div>
    <button class="btn btn-success" @onclick="ExportExcel">Exportovať do Excelu</button>
}

@if (_selectedTeacher is not null)
{
    <div class="mt-4">
        <h5>Moje bloky</h5>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-3">
                <button class="btn btn-outline-secondary" @onclick="GenerateLunchBlocks">Automaticky vygenerovať bloky na obed</button>
            </div>
        </div>
        @if (_customBlocks.Any())
        {
            <div class="mt-2">
                <ul class="list-group">
                    @foreach (var cb in _customBlocks.OrderBy(c => c.Day).ThenBy(c => c.StartHalfIndex))
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>
                                <strong>@DaySk(cb.Day)</strong> @HalfIndexToTime(cb.StartHalfIndex) - @HalfIndexToTime(cb.StartHalfIndex + cb.DurationHalfSlots), @((cb.DurationHalfSlots / 2.0).ToString("0.0"))h: @cb.Text
                                @if (cb.Vertical)
                                {
                                    <span class="badge bg-secondary ms-2">V</span>
                                    ;
                                }
                            </span>
                            <button class="btn btn-sm btn-outline-danger" title="Odstrániť" @onclick="() => RemoveCustomBlock(cb)">X</button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}

@if (_previewMap is not null)
{
    <div class="mt-3">
        <h5>Náhľad rozvrhu</h5>
        <div class="table-responsive">
            @{
                var totalHalfCols = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
            }
            <table class="table table-bordered table-sm text-center align-middle preview-table">
                <colgroup>
                    <col style="width:120px" />
                    @for (var i = 0; i < totalHalfCols; i++)
                    {
                        <col />
                    }
                </colgroup>
                <thead>
                    <tr>
                        <th></th>
                        @for (int h = ScheduleTable.FirstBlockHour; h <= ScheduleTable.LastBlockHour; h++)
                        {
                            <th colspan="2">@h:00</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var day in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday })
                    {
                        var dayName = DaySk(day);
                        var spans = _previewMap.TryGetValue(day, out var list) ? list.OrderBy(s => s.StartHalfIndex).ToList() : new List<PreviewSpan>();
                        int half = 0;
                        int totalHalf = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
                        <tr>
                            <th rowspan="2" class="align-middle" style="width:120px">@dayName</th>
                            @while (half < totalHalf)
                            {
                                var span = spans.Where(s => s.StartHalfIndex == half).OrderByDescending(s => s.IsCustom ? 1 : 0).FirstOrDefault();
                                if (span is not null)
                                {
                                    var colspan = span.DurationHalfSlots;
                                    var bg = span.IsCustom
                                    ? GetFillHexForKind(span.CustomKind ?? UserBlockKind.Blocked)
                                    : GetSubjectBasedFill(span.CourseName ?? span.SubjectShortcut, span.LessonType);
                                    var fg = GetIdealTextColor(bg);
                                    var startHalfLocal = half;
                                    <td class="clickable-cell" colspan="@colspan" rowspan="2" style="background-color:@bg; color:@fg; white-space: pre-line;"
                                        @onclick="() => OnGridCellClick(day, startHalfLocal, span.IsCustom, colspan)"
                                        @oncontextmenu:preventDefault @oncontextmenu:stopPropagation
                                        @oncontextmenu="(e) => OnCellContextMenu(e, day, startHalfLocal, span.IsCustom, colspan, span.LessonType, span.CourseName, span.SubjectShortcut, span.RoomName)">
                                        @if (span.IsCustom)
                                        {
                                            @if (span.Vertical)
                                            {
                                                <div class="vertical-text">@span.CustomText</div>
                                            }
                                            else
                                            {
                                                @span.CustomText
                                            }
                                        }
                                        else
                                        {
                                            @LessonTypeSk(span.LessonType)
                                            @if (!string.IsNullOrWhiteSpace(span.CourseName))
                                            {
                                                var subj = span.CourseName ?? span.SubjectShortcut;
                                                if (!string.IsNullOrWhiteSpace(span.CourseName) && _subjectAliases.TryGetValue(span.CourseName, out var alias) && !string.IsNullOrWhiteSpace(alias))
                                                {
                                                    subj = alias;
                                                }
                                                if (!string.IsNullOrWhiteSpace(subj))
                                                {
                                                    <br />
                                                    @subj
                                                }
                                            }
                                            @if (!string.IsNullOrWhiteSpace(span.RoomName))
                                            {
                                                <br />
                                                @span.RoomName
                                            }
                                        }
                                    </td>
                                    half += colspan;
                                }
                                else
                                {
                                    var startHalfLocal = half;
                                    <td class="clickable-cell" rowspan="2" @onclick="() => OnGridCellClick(day, startHalfLocal, false, 1)"></td>
                                    half++;
                                }
                            }
                        </tr>
                        <tr></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_editOpen)
{
    <div class="modal d-block" tabindex="0" style="background: rgba(0,0,0,.5);" @onclick="OnBackdropClick" @onkeydown="OnModalKeyDown">
        <div class="modal-dialog modal-lg">
            <div class="modal-content" @onclick:stopPropagation>
                <div class="modal-header">
                    <h5 class="modal-title">@( _editTarget is null ? "Pridať blok" : "Upraviť blok" )</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_editValidationError))
                    {
                        <div class="alert alert-danger py-2">@_editValidationError</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_editWarning))
                    {
                        <div class="alert alert-warning py-2">@_editWarning</div>
                    }
                    <div class="row g-2 align-items-end">
                        <div class="col-12 col-md-2">
                            <label class="form-label">Deň</label>
                            <select class="form-select" @bind="_editDay" @bind:after="OnEditAfterChange">
                                <option value="@DayOfWeek.Monday">Pondelok</option>
                                <option value="@DayOfWeek.Tuesday">Utorok</option>
                                <option value="@DayOfWeek.Wednesday">Streda</option>
                                <option value="@DayOfWeek.Thursday">Štvrtok</option>
                                <option value="@DayOfWeek.Friday">Piatok</option>
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Začiatok</label>
                            <input type="time" class="form-control" min="07:00" max="19:00" step="1800" @bind-value="_editStart" @bind-value:after="OnEditAfterChange" />
                        </div>
                        <div class="col-6 col-md-2">
                            <label class="form-label">Trvanie (h)</label>
                            <select class="form-select" @bind="_editDurationHalfSlots" @bind:after="OnEditAfterChange">
                                @foreach (var opt in _durationOptionsHalfSlots)
                                {
                                    <option value="@opt">@((opt / 2.0).ToString("0.0"))</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <label class="form-label">Text bloku</label>
                            <input type="text" class="form-control" @bind-value="_editText" @bind-value:event="oninput" />
                        </div>
                        <div class="col-12 col-md-2">
                            <label class="form-label">Typ</label>
                            <select class="form-select" @bind="_editKind">
                                <option value="@UserBlockKind.Lecture">Prednáška</option>
                                <option value="@UserBlockKind.Excercise">Cvičenie</option>
                                <option value="@UserBlockKind.Laboratory">Laboratórium</option>
                                <option value="@UserBlockKind.Blocked">Blok</option>
                                <option value="@UserBlockKind.Meeting">Porady</option>
                                <option value="@UserBlockKind.Consultation">Konzultácie</option>
                                <option value="@UserBlockKind.Lunch">Obed</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3">
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="editVertical" @bind="_editVertical" @bind:after="OnEditAfterChange" />
                                <label class="form-check-label" for="editVertical">Vertikálny text</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    @if (_editTarget is not null)
                    {
                        <button class="btn btn-danger" @onclick="DeleteEdit">Zmazať</button>
                    }
                    <button class="btn btn-secondary" @onclick="CancelEdit">Zrušiť</button>
                    <button class="btn btn-primary" @onclick="SaveEdit">Uložiť</button>
                </div>
            </div>
        </div>
    </div>
}

@if (_ctxOpen && _ctxTarget is not null)
{
    <div style="position:fixed; inset:0; z-index:1040;" @onclick="CloseContextMenu"></div>
    <div class="dropdown-menu show" style="@($"position:fixed; z-index:1050; left:{_ctxX}px; top:{_ctxY}px; display:block;")">
        @if (_ctxTarget.IsCustom)
        {
            <button class="dropdown-item" @onclick="RemoveCustomFromTarget">Odstrániť vlastný blok</button>
            <button class="dropdown-item" @onclick="ToggleVerticalFromTarget">@(GetCtxVerticalText())</button>
        }
        else
        {
            <button class="dropdown-item text-danger" @onclick="RemoveScheduleFromTarget">Odstrániť blok z rozvrhu</button>
            <button class="dropdown-item" @onclick="ToggleVerticalFromTarget">@(GetCtxVerticalText())</button>
        }
        <div class="dropdown-divider"></div>
        <button class="dropdown-item" @onclick="CloseContextMenu">Zrušiť</button>
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}

@code {
    private record Teacher(string PersonalNumber, string Name);
    private class SubjectAliasItem { public string Name { get; set; } = string.Empty; public string Alias { get; set; } = string.Empty; public string Color { get; set; } = "#cccccc"; }

    private enum UserBlockKind
    {
        Lecture,
        Excercise,
        Laboratory,
        Blocked,
        Meeting,
        Consultation,
        Lunch
    }

    private string _search = string.Empty;
    private List<Teacher> _suggestions = new();
    private Teacher? _selectedTeacher;
    private string? _error;
    private CancellationTokenSource? _cts;
    private bool _includeBlocks = true;
    private bool IncludeBlocks { get => _includeBlocks; set { if (_includeBlocks != value) { _includeBlocks = value; _ = BuildPreviewSchedule(); } } }

    // preview state
    private Dictionary<DayOfWeek, List<PreviewSpan>>? _previewMap;
    private Dictionary<DayOfWeek, bool[]>? _scheduleOcc;
    private List<ScheduleContent> _currentSchedule = new();

    // schedule vertical overrides
    private List<ScheduleVertical> _scheduleVerticals = new();

    // custom blocks state
    private List<CustomBlock> _customBlocks = new();
    private DayOfWeek _newBlockDay = DayOfWeek.Monday;
    private TimeOnly? _newBlockStart = new(7, 0);
    private int _newBlockDurationHalfSlots = 2; //1.0h by default
    private string _newBlockText = string.Empty;
    private bool _newBlockVertical = false;
    private UserBlockKind _newBlockKind = UserBlockKind.Blocked;
    private readonly int[] _durationOptionsHalfSlots = new[] { 1, 2, 3, 4, 5, 6, 8, 10, 12 }; //0.5 ..6.0h

    // inline editor (modal) state
    private bool _editOpen = false;
    private DayOfWeek _editDay = DayOfWeek.Monday;
    private TimeOnly? _editStart = new(7, 0);
    private int _editDurationHalfSlots = 2;
    private string _editText = string.Empty;
    private bool _editVertical = false;
    private UserBlockKind _editKind = UserBlockKind.Blocked;
    private CustomBlock? _editTarget;
    private string? _editValidationError;
    private string? _editWarning;

    // context menu state
    private bool _ctxOpen = false;
    private double _ctxX;
    private double _ctxY;
    private ContextTarget? _ctxTarget;

    // editor state
    private List<SubjectAliasItem> _subjectEditor = new();
    private Dictionary<string, string> _subjectAliases = new();
    private Dictionary<string, string> _subjectColors = new(StringComparer.Ordinal);

    private string AliasesStorageKey => _selectedTeacher is null
        ? "subject_aliases"
        : $"subject_aliases_{_selectedTeacher.PersonalNumber}";

    private string SubjectColorsStorageKey => _selectedTeacher is null
        ? "subject_colors"
        : $"subject_colors_{_selectedTeacher.PersonalNumber}";

    private string CustomBlocksStorageKey => _selectedTeacher is null
        ? "custom_blocks"
        : $"custom_blocks_{_selectedTeacher.PersonalNumber}";

    private string SchVerticalStorageKey => _selectedTeacher is null
        ? "schedule_vertical"
        : $"schedule_vertical_{_selectedTeacher.PersonalNumber}";

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _error = null;
        if (string.IsNullOrWhiteSpace(_search) || _search.Length < 3)
        {
            _suggestions.Clear();
            _selectedTeacher = null;
            _subjectEditor.Clear();
            _previewMap = null;
            _scheduleOcc = null;
            _currentSchedule.Clear();
            _customBlocks.Clear();
            _scheduleVerticals.Clear();
            _subjectAliases.Clear();
            _subjectColors.Clear();
            _editOpen = false;
            return;
        }
        var cts = new CancellationTokenSource();
        _cts?.Cancel();
        _cts = cts;
        try
        {
            var result = await ScheduleApi.GetUnizaTeachers(_search, cts.Token);
            _suggestions = result.Select(x => new Teacher(x.Id, x.Name)).ToList();
        }
        catch (Exception ex)
        {
            if (ex is not TaskCanceledException)
            {
                Logger.LogError(ex, "Nepodarilo sa načítať učiteľov");
                _error = "Nepodarilo sa načítať učiteľov";
            }
        }
    }

    private async Task SelectTeacher(Teacher t)
    {
        _selectedTeacher = t;
        _search = t.Name;
        _suggestions.Clear();
        _editOpen = false;
        await BuildSubjectEditor();
        await LoadCustomBlocksFromLocalStorage();
        await LoadScheduleVerticalsFromLocalStorage();
        await BuildPreviewSchedule();
    }

    private async Task BuildSubjectEditor()
    {
        _subjectEditor.Clear();
        _subjectAliases.Clear();
        _subjectColors.Clear();
        if (_selectedTeacher is null) return;
        try
        {
            var schedule = await ScheduleApi.GetUnizaScheduleContentAsync(new TeacherScheduleRequest(_selectedTeacher.PersonalNumber));

            // keep normalized schedule for preview (use selected teacher's name explicitly)
            _currentSchedule = schedule
                .Select(x => new ScheduleContent
                {
                    BlockNumber = x.BlockNumber,
                    CourseName = x.CourseName,
                    Day = x.Day,
                    TeacherName = _selectedTeacher.Name,
                    Group = x.Group,
                    LessonType = x.LessonType,
                    RoomName = x.RoomName,
                    SubjectShortcut = x.SubjectShortcut
                })
                .OrderBy(x => x.Day)
                .ThenBy(x => x.BlockNumber)
                .Distinct()
                .ToList();

            var names = schedule
                .Select(s => s.CourseName)
                .Where(n => !string.IsNullOrWhiteSpace(n))
                .Distinct()
                .OrderBy(n => n)
                .ToList();

            await LoadSubjectAliasesFromLocalStorage();
            await LoadSubjectColorsFromLocalStorage();

            // assign default colors if missing
            var palette = new[] { "#A4C2F4", "#B6D7A8", "#FFE599", "#F4CCCC", "#D9D2E9" }; //5 defaults
            int pi = 0;
            foreach (var n in names)
            {
                if (string.IsNullOrWhiteSpace(n)) continue;
                if (!_subjectColors.ContainsKey(n!))
                {
                    _subjectColors[n!] = palette[pi % palette.Length];
                    pi++;
                }
            }

            foreach (var n in names)
            {
                _subjectEditor.Add(new SubjectAliasItem
                {
                    Name = n!,
                    Alias = _subjectAliases.TryGetValue(n!, out var a) ? a : string.Empty,
                    Color = _subjectColors.TryGetValue(n!, out var c) ? c : "#cccccc"
                });
            }

            // persist any new color assignments
            await SaveSubjectColorsToLocalStorage();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nepodarilo sa pripraviť editor názvov predmetov");
        }
    }

    private async Task BuildPreviewSchedule()
    {
        try
        {
            _previewMap = new Dictionary<DayOfWeek, List<PreviewSpan>>();
            _scheduleOcc = new Dictionary<DayOfWeek, bool[]>();
            if (_selectedTeacher is null) return;

            // Ensure we have current schedule; if not, load it now
            if (_currentSchedule.Count == 0)
            {
                var schedule = await ScheduleApi.GetUnizaScheduleContentAsync(new TeacherScheduleRequest(_selectedTeacher.PersonalNumber));
                _currentSchedule = schedule
                    .Select(x => new ScheduleContent
                    {
                        BlockNumber = x.BlockNumber,
                        CourseName = x.CourseName,
                        Day = x.Day,
                        TeacherName = _selectedTeacher.Name,
                        Group = x.Group,
                        LessonType = x.LessonType,
                        RoomName = x.RoomName,
                        SubjectShortcut = x.SubjectShortcut
                    })
                    .OrderBy(x => x.Day)
                    .ThenBy(x => x.BlockNumber)
                    .Distinct()
                    .ToList();
            }

            var filtered = _includeBlocks
                ? _currentSchedule
                : _currentSchedule.Where(s => s.LessonType != KST.UnizaSchedule.Api.Enums.LessonType.Blocked);

            // half-hour occupancy by custom blocks and schedule
            var totalHalf = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
            var occupancy = new Dictionary<DayOfWeek, bool[]>();
            foreach (var d in new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday })
            {
                occupancy[d] = new bool[totalHalf];
                _scheduleOcc[d] = new bool[totalHalf];
            }
            foreach (var cb in _customBlocks)
            {
                if (!occupancy.TryGetValue(cb.Day, out var arr)) continue;
                var s = Math.Clamp(cb.StartHalfIndex, 0, totalHalf);
                var e = Math.Clamp(cb.StartHalfIndex + cb.DurationHalfSlots, 0, totalHalf);
                for (int i = s; i < e; i++) arr[i] = true;
            }

            // build schedule spans, also fill schedule occupancy
            var ordered = filtered
                .OrderBy(s => s.Day)
                .ThenBy(s => s.BlockNumber)
                .ThenBy(s => s.CourseName)
                .ToList();

            int idx = 0;
            while (idx < ordered.Count)
            {
                var cur = ordered[idx];
                int count = 1;
                int j = idx + 1;
                while (j < ordered.Count)
                {
                    var nx = ordered[j];
                    if (nx.Day == cur.Day &&
                        nx.CourseName == cur.CourseName &&
                        nx.RoomName == cur.RoomName &&
                        nx.LessonType == cur.LessonType &&
                        nx.SubjectShortcut == cur.SubjectShortcut &&
                        nx.BlockNumber == cur.BlockNumber + (j - idx))
                    {
                        count++;
                        j++;
                    }
                    else break;
                }

                var startHour = ScheduleTable.FirstBlockHour + cur.BlockNumber - 1;
                var startHalf = (startHour - ScheduleTable.FirstBlockHour) * 2;
                var durHalf = count * 2;

                // mark schedule occupancy regardless of custom blocks
                var occSch = _scheduleOcc[cur.Day];
                for (int h = startHalf; h < startHalf + durHalf; h++) occSch[h] = true;

                // split by occupancy of custom blocks for preview
                var occ = occupancy[cur.Day];
                int k = startHalf;
                int end = startHalf + durHalf;
                while (k < end)
                {
                    while (k < end && occ[k]) k++;
                    if (k >= end) break;
                    int segStart = k;
                    while (k < end && !occ[k]) k++;
                    int segDur = k - segStart;
                    if (segDur > 0)
                    {
                        AddSpan(new PreviewSpan
                        {
                            Day = cur.Day,
                            StartHalfIndex = segStart,
                            DurationHalfSlots = segDur,
                            LessonType = cur.LessonType,
                            CourseName = cur.CourseName,
                            SubjectShortcut = cur.SubjectShortcut,
                            RoomName = cur.RoomName,
                            IsCustom = false,
                            Vertical = IsScheduleSpanVertical(cur.Day, segStart, segDur)
                        });
                    }
                }

                idx = j;
            }

            // add custom spans
            foreach (var cb in _customBlocks)
            {
                AddSpan(new PreviewSpan
                {
                    Day = cb.Day,
                    StartHalfIndex = cb.StartHalfIndex,
                    DurationHalfSlots = cb.DurationHalfSlots,
                    LessonType = KST.UnizaSchedule.Api.Enums.LessonType.Blocked,
                    CustomText = cb.Text,
                    IsCustom = true,
                    Vertical = cb.Vertical,
                    CustomKind = cb.Kind
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Nepodarilo sa pripraviť náhľad rozvrhu");
        }
    }

    private bool IsScheduleSpanVertical(DayOfWeek day, int startHalf, int durationHalf)
        => _scheduleVerticals.Any(v => v.Day == day && v.StartHalf == startHalf && v.DurationHalf == durationHalf);

    private void AddSpan(PreviewSpan span)
    {
        if (_previewMap is null) return;
        if (!_previewMap.TryGetValue(span.Day, out var list))
        {
            list = new List<PreviewSpan>();
            _previewMap[span.Day] = list;
        }
        list.Add(span);
    }

    private async Task GenerateLunchBlocks()
    {
        if (_selectedTeacher is null) return;
        // Ensure occupancy is up to date
        await BuildPreviewSchedule();
        int totalHalf = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
        var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
        foreach (var day in days)
        {
            if (_scheduleOcc is null || !_scheduleOcc.TryGetValue(day, out var occ)) continue;
            // Avoid duplicate lunch per day
            if (_customBlocks.Any(c => c.Day == day && c.Kind == UserBlockKind.Lunch)) continue;
            int h1130 = (11 - ScheduleTable.FirstBlockHour) * 2 + 1;
            int h1200 = (12 - ScheduleTable.FirstBlockHour) * 2;
            var candidates = new[] { h1130, h1200 };
            foreach (var start in candidates)
            {
                if (start < 0 || start >= totalHalf) continue;
                if (occ[start]) continue; // schedule occupied
                if (!TryValidateCustom(day, start, 1, null, out _, out var overlapsSchedule)) continue;
                if (overlapsSchedule) continue; // avoid schedule overlap as well
                _customBlocks.Add(new CustomBlock
                {
                    Day = day,
                    StartHalfIndex = start,
                    DurationHalfSlots = 1,
                    Text = "Obed",
                    Kind = UserBlockKind.Lunch,
                    Vertical = true
                });
                break;
            }
        }
        await SaveCustomBlocksToLocalStorage();
        await BuildPreviewSchedule();
    }

