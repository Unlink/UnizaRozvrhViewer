    private bool TryValidateCustom(DayOfWeek day, int startHalf, int durationHalf, CustomBlock? ignore, out string? error, out bool overlapsSchedule)
    {
        error = null;
        overlapsSchedule = false;
        int totalHalf = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
        if (durationHalf < 1) { error = "Trvanie musí byť aspoň0.5 hodiny."; return false; }
        if (startHalf < 0 || startHalf >= totalHalf) { error = "Začiatok je mimo povolený rozsah."; return false; }
        if (startHalf + durationHalf > totalHalf) { error = "Blok presahuje koniec dňa."; return false; }
        // overlap with other custom blocks (same day)
        foreach (var cb in _customBlocks)
        {
            if (ignore is not null && ReferenceEquals(cb, ignore)) continue;
            if (cb.Day != day) continue;
            int s1 = startHalf, e1 = startHalf + durationHalf;
            int s2 = cb.StartHalfIndex, e2 = cb.StartHalfIndex + cb.DurationHalfSlots;
            if (s1 < e2 && s2 < e1) { error = "Blok sa prekrýva s iným vlastným blokom."; return false; }
        }
        // schedule overlap (warning)
        if (_scheduleOcc != null && _scheduleOcc.TryGetValue(day, out var arr))
        {
            for (int i = startHalf; i < startHalf + durationHalf; i++) if (arr[i]) { overlapsSchedule = true; break; }
        }
        return true;
    }

    private async Task SaveEdit()
    {
        _editValidationError = null;
        _editWarning = null;
        if (_editStart is null) return;
        var h = _editStart.Value.Hour;
        var m = _editStart.Value.Minute;
        var halfIndex = (h - ScheduleTable.FirstBlockHour) * 2 + (m >= 30 ? 1 : 0);
        if (!TryValidateCustom(_editDay, halfIndex, Math.Max(1, _editDurationHalfSlots), _editTarget, out var err, out var warn))
        {
            _editValidationError = err;
            return;
        }
        _editWarning = warn ? "Pozor: blok sa prekrýva s existujúcim rozvrhom." : null;
        if (_editTarget is null)
        {
            var cb = new CustomBlock
            {
                Day = _editDay,
                StartHalfIndex = halfIndex,
                DurationHalfSlots = Math.Max(1, _editDurationHalfSlots),
                Text = _editText?.Trim() ?? string.Empty,
                Kind = _editKind,
                Vertical = _editVertical
            };
            _customBlocks.Add(cb);
        }
        else
        {
            _editTarget.Day = _editDay;
            _editTarget.StartHalfIndex = halfIndex;
            _editTarget.DurationHalfSlots = Math.Max(1, _editDurationHalfSlots);
            _editTarget.Text = _editText?.Trim() ?? string.Empty;
            _editTarget.Kind = _editKind;
            _editTarget.Vertical = _editVertical;
        }
        await SaveCustomBlocksToLocalStorage();
        await BuildPreviewSchedule();
        _editOpen = false;
    }

    private async Task DeleteEdit()
    {
        if (_editTarget is null) { _editOpen = false; return; }
        _customBlocks.Remove(_editTarget);
        await SaveCustomBlocksToLocalStorage();
        await BuildPreviewSchedule();
        _editOpen = false;
    }

