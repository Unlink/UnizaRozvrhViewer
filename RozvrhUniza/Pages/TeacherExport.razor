    private async Task GenerateLunchBlocks()
    {
        if (_selectedTeacher is null) return;
        await BuildPreviewSchedule();
        int totalHalf = (ScheduleTable.LastBlockHour - ScheduleTable.FirstBlockHour + 1) * 2;
        var days = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday };
        foreach (var day in days)
        {
            if (_scheduleOcc is null || !_scheduleOcc.TryGetValue(day, out var occ)) continue;
            // Avoid duplicate lunch per day
            if (_customBlocks.Any(c => c.Day == day && c.Kind == UserBlockKind.Lunch)) continue;
            int h1130 = (11 - ScheduleTable.FirstBlockHour) * 2 + 1;
            int h1200 = (12 - ScheduleTable.FirstBlockHour) * 2;
            var candidates = new[] { h1130, h1200 };
            foreach (var start in candidates)
            {
                if (start < 0 || start >= totalHalf) continue;
                if (occ[start]) continue; // schedule occupied
                if (!TryValidateCustom(day, start, 1, null, out _, out var overlapsSchedule)) continue;
                if (overlapsSchedule) continue; // avoid schedule overlap as well
                _customBlocks.Add(new CustomBlock
                {
                    Day = day,
                    StartHalfIndex = start,
                    DurationHalfSlots = 1,
                    Text = "Obed",
                    Kind = UserBlockKind.Lunch,
                    Vertical = true
                });
                break;
            }
        }
        await SaveCustomBlocksToLocalStorage();
        await BuildPreviewSchedule();
    }
