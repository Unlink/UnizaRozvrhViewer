    private void OnCellContextMenu(MouseEventArgs e, DayOfWeek day, int startHalf, bool isCustom, int durationHalf,
    KST.UnizaSchedule.Api.Enums.LessonType type, string? course, string? subj, string? room)
    {
        _ctxTarget = new ContextTarget
        {
            Day = day,
            StartHalf = startHalf,
            DurationHalf = durationHalf,
            IsCustom = isCustom,
            Type = type,
            CourseName = course,
            SubjectShortcut = subj,
            RoomName = room
        };
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _ctxOpen = true;
    }

    private void CloseContextMenu()
    {
        _ctxOpen = false;
        _ctxTarget = null;
    }

    private string GetCtxVerticalText()
    {
        if (_ctxTarget is null) return "Vertikálny text";
        bool isVert = _ctxTarget.IsCustom
        ? _customBlocks.Any(x => x.Day == _ctxTarget.Day && x.StartHalfIndex == _ctxTarget.StartHalf && x.DurationHalfSlots == _ctxTarget.DurationHalf && x.Vertical)
        : _scheduleVerticals.Any(x => x.Day == _ctxTarget.Day && x.StartHalf == _ctxTarget.StartHalf && x.DurationHalf == _ctxTarget.DurationHalf);
        return isVert ? "Vypnúť vertikálny text" : "Zapnúť vertikálny text";
    }

    private async Task ToggleVerticalFromTarget()
    {
        if (_ctxTarget is null) return;
        if (_ctxTarget.IsCustom)
        {
            var cb = _customBlocks.FirstOrDefault(x => x.Day == _ctxTarget.Day && x.StartHalfIndex == _ctxTarget.StartHalf && x.DurationHalfSlots == _ctxTarget.DurationHalf);
            if (cb is not null)
            {
                cb.Vertical = !cb.Vertical;
                await SaveCustomBlocksToLocalStorage();
            }
        }
        else
        {
            var existing = _scheduleVerticals.FirstOrDefault(x => x.Day == _ctxTarget.Day && x.StartHalf == _ctxTarget.StartHalf && x.DurationHalf == _ctxTarget.DurationHalf);
            if (existing is null)
                _scheduleVerticals.Add(new ScheduleVertical { Day = _ctxTarget.Day, StartHalf = _ctxTarget.StartHalf, DurationHalf = _ctxTarget.DurationHalf });
            else
                _scheduleVerticals.Remove(existing);
            await SaveScheduleVerticalsToLocalStorage();
        }
        await BuildPreviewSchedule();
        CloseContextMenu();
    }

    private async Task RemoveCustomFromTarget()
    {
        if (_ctxTarget is null) return;
        var t = _ctxTarget;
        var cb = _customBlocks.FirstOrDefault(x => x.Day == t.Day && x.StartHalfIndex == t.StartHalf && x.DurationHalfSlots == t.DurationHalf);
        if (cb is not null)
        {
            _customBlocks.Remove(cb);
            await SaveCustomBlocksToLocalStorage();
            await BuildPreviewSchedule();
        }
        CloseContextMenu();
    }

    private async Task RemoveScheduleFromTarget()
    {
        if (_ctxTarget is null) return;
        var t = _ctxTarget;
        int startBlock = (t.StartHalf / 2) + 1;
        int lastBlock = ((t.StartHalf + t.DurationHalf - 1) / 2) + 1;
        bool Same(string? a, string? b) => string.Equals(a ?? string.Empty, b ?? string.Empty, StringComparison.Ordinal);

        _currentSchedule = _currentSchedule
        .Where(s => !(s.Day == t.Day && s.LessonType == t.Type && Same(s.CourseName, t.CourseName) && Same(s.SubjectShortcut, t.SubjectShortcut) && Same(s.RoomName, t.RoomName) && s.BlockNumber >= startBlock && s.BlockNumber <= lastBlock))
        .ToList();

        await BuildPreviewSchedule();
        CloseContextMenu();
    }

