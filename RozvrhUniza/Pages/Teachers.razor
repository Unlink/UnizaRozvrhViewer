@page "/teachers"
@using KST.UnizaSchedule.Table
@using KST.UnizaSchedule.Api
@using KST.UnizaSchedule.Api.Enums
@using KST.UnizaSchedule.Api.ScheduleRequests
@using RozvrhUniza.Components
@inject ILogger<Home> Logger
@inject IJSRuntime JS

<PageTitle>Prehľadný rozvrh - Učitelia</PageTitle>

<form onsubmit="return false;">
    <div class="row g-3">
        <div class="col-md-8">
            <div class="mb-3">
                <label class="form-label">Vybraní učitelia</label>
                <ul class="list-group">
                    @foreach (var t in _teachers)
                    {
                        <li class="list-group-item">@t.Name <button class="ms btn btn-sm btn-danger" @onclick="() => RemoveTeacher(t)">X</button></li>
                    }
                </ul>
            </div>

            <div class="mb-3">
                <label class="form-label">Pridať učiteľa</label>
                <input type="text" class="form-control" value="@_name" @oninput="InputChanged" @ref="_elRef">
                @if (_suggestions.Any())
                {
                    <ul class="dropdown-menu d-block">
                        @foreach (var s in _suggestions)
                        {
                            <li @onclick="() => AddTeacher(s)"><a class="dropdown-item">@s.Name</a></li>
                        }
                    </ul>
                }
            </div>
            <button type="submit" class="btn btn-primary" @onclick="LoadRozvrh">Zobraziť rozvrh</button>
        </div>
        <div class="col-md-4">
            <div class="mb-3">
                <label class="form-label">Názov novej záložky</label>
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Moja skupina" @bind="_groupName">
                    <button class="btn btn-outline-primary" type="button" @onclick="SaveCurrentGroup">Uložiť aktuálny zoznam</button>
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Uložené skupiny</label>
                @if (_teacherGroups.Any())
                {
                    <ul class="list-group">
                        @foreach (var g in _teacherGroups)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-link text-start text-decoration-none flex-grow-1 p-0" @onclick="() => LoadGroup(g)">@g.Name (@g.Teachers.Count)</button>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-2" title="Zmazať skupinu" @onclick:stopPropagation="true" @onclick="() => DeleteGroup(g)">X</button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-muted">Zatiaľ nemáte uložené žiadne skupiny.</div>
                }
            </div>
        </div>
    </div>
</form>

@if (_sheduleData != null)
{
    <ScheduleView Data="@this._sheduleData" ShowSubject="true" />
}

@if (_hasError)
{
    <div class="alert alert-danger" role="alert">
        Rozvrh nenájdený!
    </div>
}

@code {
    private record Teacher(string PersonalNumber, string Name);
    private record TeacherGroup(string Name, List<Teacher> Teachers);

    private List<Teacher> _teachers = new();
    private string _name = "";
    private List<Teacher> _suggestions = new();
    private CancellationTokenSource? _cts;
    private ElementReference _elRef;
    private bool _hasError = false;
    private GroupedScheduleTable? _sheduleData;
    private const string TeachersStorageKey = "vybrani_ucitelia";
    private const string TeacherGroupsStorageKey = "ucitelske_zalozky";

    private string _groupName = string.Empty;
    private List<TeacherGroup> _teacherGroups = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LoadTeachersFromLocalStorage();
        await LoadGroupsFromLocalStorage();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _elRef.FocusAsync();
        }
    }

    private async Task LoadRozvrh()
    {
        this._sheduleData = null;
        _hasError = false;
        try
        {
            var schedules = new List<ScheduleContent>();
            foreach (var teacherSchedule in _teachers)
            {
                schedules.AddRange((
                    await ScheduleApi.GetUnizaScheduleContentAsync(new TeacherScheduleRequest(teacherSchedule.PersonalNumber)))
                    .Select(x => new ScheduleContent
                    {
                        BlockNumber = x.BlockNumber,
                        CourseName = x.CourseName,
                        Day = x.Day,
                        TeacherName = teacherSchedule.Name,
                        Group = x.Group,
                        LessonType = x.LessonType,
                        RoomName = x.RoomName,
                        SubjectShortcut = x.SubjectShortcut
                    }));
            }

            this._sheduleData = schedules
                .OrderBy(x => x.Day)
                .ThenBy(x => x.BlockNumber)
                .Distinct()
                .MergeMultipleBlocksOfOnePerson()
                //.MergeMultipleTeachers()
                .ToTable()
                .GroupSameBlocks();
            _hasError = false;
        }
        catch (Exception ex)
        {
            _hasError = true;
            Logger.LogError(ex, "Nepodarilo sa načítať rozvrh");
        }
        StateHasChanged();
    }

    private async Task InputChanged(ChangeEventArgs arg)
    {
        var text = arg.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(text))
        {
            _name = text;
            var cts = new CancellationTokenSource();
            _cts?.Cancel();
            _cts = cts;
            try
            {
                var result = await ScheduleApi.GetUnizaTeachers(_name, cts.Token);
                _suggestions = result.Select(x => new Teacher(x.Id, x.Name)).ToList();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Nepodarilo sa načítať učiteľov");
            }
        }
    }

    private async Task AddTeacher(Teacher teacher)
    {
        if (!_teachers.Contains(teacher))
        {
            _teachers.Add(teacher);
            await SaveTeachersToLocalStorage();
        }
        _name = "";
        _suggestions = new List<Teacher>();
        await _elRef.FocusAsync();
    }

    private async Task RemoveTeacher(Teacher teacher)
    {
        _teachers.Remove(teacher);
        await SaveTeachersToLocalStorage();
    }

    private async Task SaveTeachersToLocalStorage()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_teachers);
        await JS.InvokeVoidAsync("localStorage.setItem", TeachersStorageKey, json);
    }

    private async Task LoadTeachersFromLocalStorage()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", TeachersStorageKey);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<List<Teacher>>(json);
                if (loaded != null)
                    _teachers = loaded;
            }
            catch { }
        }
    }

    private async Task SaveCurrentGroup()
    {
        if (string.IsNullOrWhiteSpace(_groupName) || !_teachers.Any())
        {
            return;
        }

        // Update if name already exists, else add new
        var existing = _teacherGroups.FirstOrDefault(g => string.Equals(g.Name, _groupName, StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            _teacherGroups.Remove(existing);
        }
        _teacherGroups.Add(new TeacherGroup(_groupName.Trim(), _teachers.Select(t => new Teacher(t.PersonalNumber, t.Name)).ToList()));

        await SaveGroupsToLocalStorage();
        _groupName = string.Empty;
        StateHasChanged();
    }

    private async Task LoadGroup(TeacherGroup group)
    {
        _teachers = group.Teachers.Select(t => new Teacher(t.PersonalNumber, t.Name)).ToList();
        await SaveTeachersToLocalStorage();
        _name = string.Empty;
        _suggestions.Clear();
        await _elRef.FocusAsync();
        StateHasChanged();
    }

    private async Task DeleteGroup(TeacherGroup group)
    {
        _teacherGroups.RemoveAll(g => string.Equals(g.Name, group.Name, StringComparison.OrdinalIgnoreCase));
        await SaveGroupsToLocalStorage();
        StateHasChanged();
    }

    private async Task SaveGroupsToLocalStorage()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(_teacherGroups);
        await JS.InvokeVoidAsync("localStorage.setItem", TeacherGroupsStorageKey, json);
    }

    private async Task LoadGroupsFromLocalStorage()
    {
        var json = await JS.InvokeAsync<string>("localStorage.getItem", TeacherGroupsStorageKey);
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<List<TeacherGroup>>(json);
                if (loaded != null)
                    _teacherGroups = loaded;
            }
            catch { }
        }
    }
}